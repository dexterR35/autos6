# Frontend (exposed to the browser — never put secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# true = clearly labelled demo fixtures, no real payments. false = live data from Supabase.
VITE_DEMO_MODE=true
# Slug of the projects row to display in live mode
VITE_PROJECT_SLUG=project-s6

# --- SEO & analytics (public) ---
# Absolute public URL, no trailing slash. Needed for canonical, og:url/og:image, JSON-LD and sitemap.xml.
VITE_SITE_URL=
# true on staging/previews: noindex everywhere and robots.txt disallows all.
VITE_NOINDEX=false
# Google Tag Manager container id (GTM-XXXXXXX). Empty = no GTM, no consent banner.
VITE_GTM_ID=
# Load GTM during `npm run dev` too (default: production builds only).
VITE_GTM_IN_DEV=false
# Set false to omit GTM's <noscript> iframe.
VITE_GTM_NOSCRIPT=true
