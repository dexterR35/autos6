# Server-only secrets. Never prefix these with VITE_.
SUPABASE_URL=
# New-style secret key (sb_secret_...). SUPABASE_SERVICE_ROLE_KEY is accepted as a legacy fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_ORIGIN=http://localhost:5173
PORT=3001
# Donation limits in cents
DONATION_MIN_CENTS=100
DONATION_MAX_CENTS=1000000
# Email updates (Resend verified sender). Confirmations and queued updates are sent every 30s.
RESEND_API_KEY=
EMAIL_FROM=
# At least 32 random characters; keep stable so unsubscribe links stay valid.
SUBSCRIPTION_SIGNING_SECRET=
# Public operator identity must match frontend legal pages before production payments open.
OPERATOR_NAME=
CONTACT_EMAIL=
# Same public asset folder as VITE_MODEL_ASSET_BASE_URL; included in the CSP.
MODEL_ASSET_BASE_URL=
